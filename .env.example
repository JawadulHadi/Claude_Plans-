# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (voyage-3-lite embeddings — Phase 3)
# Get key at: https://dash.voyageai.com
VOYAGE_API_KEY=

# Supabase (local: http://localhost:54321)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (local: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Google OAuth (Gmail + Calendar — Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Per-user access tokens (stored in Supabase; injected at runtime)
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Optional: Slack webhook for notifications (Phase 4)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Bull Board admin UI (Phase 4)
# Set any strong token — required in X-Admin-Token header to access /admin/queues
ADMIN_TOKEN=
